# WRFrontiersDB-Orchestrator secrets — EXAMPLE ONLY (safe to commit; no values).
#
# The real file is NOT in this repo and NOT anywhere `dev` can read it. `dev` is
# the repo-writable, AI-touched account, so these secrets live in ethan's space,
# mode 600, mirroring ~ethan/.config/steam-price-tracker/smtp.env:
#
#   ~ethan/.config/wrf-orchestrator/secrets.env   (chmod 600, ethan-owned)
#
# Create it once (as ethan):
#   install -d -m 700 ~/.config/wrf-orchestrator
#   cp /srv/dev/repos/WRFrontiersDB-Orchestrator/secrets.env.example \
#      ~/.config/wrf-orchestrator/secrets.env
#   chmod 600 ~/.config/wrf-orchestrator/secrets.env
#   # then fill in the three values below, by hand
#
# The pipeline runs as `dev` and CANNOT read this file. An ethan-owned launcher
# sources it and injects the three values into the dev run's ENVIRONMENT, e.g.:
#   set -a; . ~/.config/wrf-orchestrator/secrets.env; set +a
#   sudo -u dev --preserve-env=STEAM_USERNAME,STEAM_PASSWORD,GH_DATA_REPO_PAT \
#     /srv/dev/repos/WRFrontiersDB-Orchestrator/.venv/bin/python src/run.py ...
# so dev only ever sees them transiently in a running process, never at rest.
# (That launcher belongs in my-system, review-gated — a follow-up.)

# Steam account used by the Exporter's DepotDownloader step.
STEAM_USERNAME=""
STEAM_PASSWORD=""

# Fine-grained PAT with push access to Surxe/WRFrontiersDB-Data (Parser push).
GH_DATA_REPO_PAT=""

# Run-report email (OPTIONAL). After every run the orchestrator emails a report
# (per-step warning/error counts + file:// links to the logs). It is enabled only
# when all three below are set; absent any, the report is logged and no mail is
# sent. These are the orchestrator's OWN settings (independent of the Steam price
# tracker); the same Gmail account can back both, but nothing is shared in code
# and this PR creates no new credential file — add the values here by hand.
# Gmail needs a 16-char App Password (2-Step Verification on), not the account
# password. SMTP_HOST/SMTP_PORT default to smtp.gmail.com:587 (non-secret, in .env).
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_TO=""
