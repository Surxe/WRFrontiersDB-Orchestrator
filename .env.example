# Use forward slashes "/" in paths for compatibility across platforms

# Logging
# Logging level. Must be one of: TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL="DEBUG"

# Directory for the orchestrator's own logs. Each run creates a timestamped
# subdir with one file per stage plus a run.log.
LOG_DIR="logs"


# Paths
# Shared root for all game data. Every stage directory (steam-download, mapper,
# exports, parsed, textures, prefix, proton) is derived from this. The only
# heavy path knob.
# Example: /srv/dev/wrf
WRF_ROOT="/srv/dev/wrf"

# Parent directory holding the sibling repos (WRFrontiers-Exporter,
# WRFrontiersDB-Parser, WRFrontiersDB-Site, WRFrontiersDB-Data).
# Example: /srv/dev/repos
REPOS_DIR="/srv/dev/repos"


# Secrets
# Steam username for the Exporter's DepotDownloader step.
# Example: example_user
STEAM_USERNAME=""

# Steam password for the Exporter's DepotDownloader step.
# Example: example_password
STEAM_PASSWORD=""

# PAT with push access to the data repo, for the Parser's push step.
# Example: github_pat_XXXXXXXXXXXXXXXX
GH_DATA_REPO_PAT=""


# Patch
# Release date of the patch being processed, as yyyy-mm-dd. Names the .usmap,
# the data archive dir, and the Parser push. Confirmed against the SteamDB
# manifest date in preflight.
# Example: 2026-08-22
GAME_VERSION=""

# Steam manifest ID to download. 'latest' uses the newest manifest.
MANIFEST_ID="latest"

# Branch in the data repo the Parser pushes to.
TARGET_BRANCH="dev"

# Skip the interactive manifest-date confirmation gate. Requires GAME_VERSION to
# be set explicitly. For non-interactive runs only.
ASSUME_MANIFEST_CONFIRMED="False"


# Stages
# Run the Exporter (Steam download, mapper, BatchExport).
SHOULD_EXPORT="False"

# Run the Parser over the exported JSON.
SHOULD_PARSE="False"

# Push the parsed data to the data repo (implies parse output exists).
SHOULD_PUSH_DATA="False"

# Build the Astro site (npm run build) against the updated data repo.
SHOULD_BUILD_SITE="False"


# Exporter
# Forwarded to the Exporter: download/update its tool dependencies.
# Required when SHOULD_EXPORT is True
SHOULD_DOWNLOAD_DEPENDENCIES="False"

# Forwarded to the Exporter: re-download dependencies even if already present.
# Required when SHOULD_EXPORT is True
FORCE_DOWNLOAD_DEPENDENCIES="False"

# Forwarded to the Exporter: download/update the game via DepotDownloader.
# Required when SHOULD_EXPORT is True
SHOULD_DOWNLOAD_STEAM_GAME="False"

# Forwarded to the Exporter: re-download/update the game even if already present.
# Required when SHOULD_EXPORT is True
FORCE_STEAM_DOWNLOAD="False"

# Forwarded to the Exporter: generate the .usmap (runs as dev under gamescope
# headless; see README).
# Required when SHOULD_EXPORT is True
SHOULD_GET_MAPPER="False"

# Forwarded to the Exporter: re-generate the .usmap even if it already exists.
# Required when SHOULD_EXPORT is True
FORCE_GET_MAPPER="False"

# Forwarded to the Exporter: run BatchExport to produce JSON.
# Required when SHOULD_EXPORT is True
SHOULD_BATCH_EXPORT="False"

# Forwarded to the Exporter: re-run BatchExport even if the output directory is
# not empty.
# Required when SHOULD_EXPORT is True
FORCE_EXPORT="False"

# Forwarded to the Exporter/Parser: export and push textures.
# Required when SHOULD_EXPORT is True
SHOULD_EXPORT_TEXTURES="True"

# Forwarded to the Exporter mapper step: launch under gamescope's headless
# backend. Default true (unattended dev runs).
# Required when SHOULD_EXPORT is True
HEADLESS="True"
